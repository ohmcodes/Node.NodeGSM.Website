# Copy to .env (never commit .env). Every line is optional.

# Long random string; enables the moderation endpoints (delete a comment, revert community info, review submissions)
ADMIN_TOKEN=

# 1 when behind a reverse proxy you control
TRUST_PROXY=0

# Fine-grained token limited to the Catalogue repo (Contents + Pull requests: read/write). Empty = no automatic draft pull requests
GITHUB_TOKEN=

# The app whose release downloads are shown on the front page
APP_REPO=ohmcodes/Node.NodeGSM
